# ─────────────────────────────────────────────────
# SAD Carcinicultura — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# ─────────────────────────────────────────────────

# Banco de dados (PostgreSQL/Supabase via pg8000). Sem esta variável usa sqlite:///./local_dev.db
DATABASE_URL=postgresql+pg8000://USUARIO:SENHA@HOST:5432/postgres
DATABASE_URL_SYNC=postgresql://USUARIO:SENHA@HOST:5432/postgres
# Usa local_dev.db se o banco remoto estiver inacessível (somente desenvolvimento)
DB_FALLBACK_SQLITE=false

# JWT
JWT_SECRET_KEY=TROQUE-POR-UMA-CHAVE-SEGURA-DE-64-CARACTERES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_TITLE=SAD Carcinicultura
APP_VERSION=4.0.0
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
