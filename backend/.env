# PostgreSQL
DATABASE_URL=postgresql+asyncpg://sad_user:sad_pass@localhost:5432/sad_carcinicultura
DATABASE_URL_SYNC=postgresql://sad_user:sad_pass@localhost:5432/sad_carcinicultura

# JWT
